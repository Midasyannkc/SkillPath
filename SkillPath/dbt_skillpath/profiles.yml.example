# Copy to ~/.dbt/profiles.yml and fill in credentials via environment
# variables. Never commit a real profiles.yml with live credentials.

skillpath:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: TRANSFORMER
      database: SKILLPATH_DEV
      warehouse: TRANSFORM_WH
      schema: dbt_dev
      threads: 4
    prod:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: TRANSFORMER
      database: SKILLPATH_PROD
      warehouse: TRANSFORM_WH
      schema: analytics
      threads: 8
